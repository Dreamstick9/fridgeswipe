# ─── PASTE KEYS HERE ────────────────────────────────────────────────────────
# 1) NVIDIA NIM — free, used for ALL heavy testing/burn-in.
#    Get at: https://build.nvidia.com  → any model card → "Get API Key"
NVIDIA_API_KEY=

# 2) OpenAI — hackathon credits. Used ONLY for final runs + Whisper fallback.
#    Get at: https://press-and-code.lovable.app
OPENAI_API_KEY=

# 3) ElevenLabs — optional, only if we add a spoken warning.
ELEVENLABS_API_KEY=

# ─── PROVIDER SWITCH ────────────────────────────────────────────────────────
# nim | openai   (default nim, so we never burn OpenAI credits by accident)
LLM_PROVIDER=nim
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct
OPENAI_MODEL=gpt-4o-mini

# ─── SAFETY RAILS ───────────────────────────────────────────────────────────
MAX_SPEND_USD=2.00
SERVER_PORT=8787
LAN_IP=10.10.29.28
