{
  "expo": {
    "name": "RED FLAG",
    "slug": "red-flag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "RED FLAG listens to the call on speaker to detect scam manipulation. Nothing is recorded or uploaded."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "backgroundColor": "#07070a",
      "permissions": [
        "RECORD_AUDIO",
        "READ_PHONE_STATE",
        "POST_NOTIFICATIONS"
      ],
      "package": "com.dreamsticks.redflag"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#07070a",
    "splash": {
      "backgroundColor": "#07070a"
    },
    "scheme": "redflag",
    "extra": {
      "eas": {
        "projectId": "30d4a42a-5f6b-4709-baee-d33b1c58a364"
      }
    },
    "owner": "dreamstick"
  }
}
